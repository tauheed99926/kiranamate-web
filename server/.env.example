# ==============================================================================
# KiranaMate Backend Environment Variables (Production & Development Example)
# NOTE: Replace placeholder values with your real configuration.
# NEVER commit real passwords, secrets, or keys to version control.
# ==============================================================================

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Node Environment ('production' for live deployments, 'development' for local)
NODE_ENV=production

# ------------------------------------------------------------------------------
# DATABASE URL OPTIONS:
# Option 1: SQLite (File-based database, default for local and persistent disk)
# DATABASE_URL="file:./data/kiranamate.db"
#
# Option 2: PostgreSQL (Recommended for multi-user public hosting on Render/Supabase/Neon)
# DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL="file:./data/kiranamate.db"

# JWT Secret Key (Generate a random 32+ character string for token signing)
# Example command to generate: openssl rand -base64 32
JWT_SECRET="your-secure-random-jwt-secret-key-here"

# Allowed CORS Origins (Comma-separated URLs for your frontend, or '*' to allow all)
# Example: https://your-frontend-app.onrender.com,https://your-frontend.vercel.app
CORS_ORIGIN="http://localhost:5173"
